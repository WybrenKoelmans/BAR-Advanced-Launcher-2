<?xml version="1.0" encoding="utf-8"?>
<local:LogPageBase
    x:Class="BAR_Advanced_Launcher_2.Views.LogPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:BAR_Advanced_Launcher_2.Views"
    xmlns:logging="using:BAR_Advanced_Launcher_2.Services.Logging"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Spacing="12">
            <TextBlock Text="Application log"
                       Style="{StaticResource TitleTextBlockStyle}"
                       VerticalAlignment="Center" />
            <Button Content="Clear"
                    VerticalAlignment="Center"
                    Command="{x:Bind ViewModel.ClearCommand}" />
        </StackPanel>

        <ListView Grid.Row="1"
                  ItemsSource="{x:Bind ViewModel.Entries, Mode=OneWay}"
                  SelectionMode="Extended"
                  FontFamily="Consolas">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="logging:AppLogEntry">
                    <StackPanel Spacing="2" Padding="0,4">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{x:Bind TimeText}" Opacity="0.6" />
                            <TextBlock Text="{x:Bind LevelText}" />
                            <TextBlock Text="{x:Bind ShortCategory}" Opacity="0.6" />
                        </StackPanel>
                        <TextBlock Text="{x:Bind Message}" TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind Exception}"
                                   TextWrapping="Wrap"
                                   Opacity="0.7"
                                   Visibility="{x:Bind Exception, Converter={StaticResource NullToVisibilityConverter}}" />
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</local:LogPageBase>
