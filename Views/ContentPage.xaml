<?xml version="1.0" encoding="utf-8"?>
<local:ContentPageBase
    x:Class="BAR_Advanced_Launcher_2.Views.ContentPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:BAR_Advanced_Launcher_2.Views"
    xmlns:models="using:BAR_Advanced_Launcher_2.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Loaded="OnLoaded">

    <Grid Padding="24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Spacing="12">
            <TextBlock Text="Content" Style="{StaticResource TitleTextBlockStyle}" VerticalAlignment="Center" />
            <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Width="20" Height="20" />
            <Button Content="Re-parse cache" Command="{x:Bind ViewModel.RefreshCommand}" VerticalAlignment="Center" />
            <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                       Opacity="0.7"
                       VerticalAlignment="Center" />
        </StackPanel>

        <StackPanel Grid.Row="1" Spacing="8">
            <InfoBar IsOpen="True" IsClosable="False" Severity="Warning"
                     Title="Degraded index"
                     Message="{x:Bind ViewModel.DegradedMessage, Mode=OneWay}"
                     Visibility="{x:Bind ViewModel.DegradedMessage, Mode=OneWay, Converter={StaticResource NullToVisibilityConverter}}" />
            <InfoBar IsOpen="True" IsClosable="False" Severity="Informational"
                     Title="Not indexed"
                     Message="{x:Bind ViewModel.NotIndexedMessage, Mode=OneWay}"
                     Visibility="{x:Bind ViewModel.NotIndexedMessage, Mode=OneWay, Converter={StaticResource NullToVisibilityConverter}}" />
        </StackPanel>

        <Pivot Grid.Row="2">

            <PivotItem Header="Maps">
                <Grid ColumnSpacing="16" RowSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="3*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBox PlaceholderText="Filter by name or author"
                             Text="{x:Bind ViewModel.MapFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <Button Grid.Column="1" Content="Open maps folder"
                            HorizontalAlignment="Left"
                            Command="{x:Bind ViewModel.OpenMapsFolderCommand}" />

                    <ListView Grid.Row="1"
                              ItemsSource="{x:Bind ViewModel.Maps, Mode=OneWay}"
                              SelectedItem="{x:Bind ViewModel.SelectedMap, Mode=TwoWay}">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:MapArchive">
                                <StackPanel Padding="0,4">
                                    <TextBlock Text="{x:Bind DisplayName}" />
                                    <TextBlock Text="{x:Bind Author}" Opacity="0.6" FontSize="12" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <ScrollViewer Grid.Row="1" Grid.Column="1">
                        <StackPanel Spacing="6"
                                    Visibility="{x:Bind ViewModel.SelectedMap, Mode=OneWay, Converter={StaticResource NullToVisibilityConverter}}">
                            <TextBlock Text="{x:Bind ViewModel.SelectedMap.Name, Mode=OneWay}"
                                       Style="{StaticResource SubtitleTextBlockStyle}"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{x:Bind ViewModel.SelectedMap.Description, Mode=OneWay}" TextWrapping="Wrap" />
                            <TextBlock Text="{x:Bind ViewModel.SelectedMap.Author, Mode=OneWay}" Opacity="0.7" TextWrapping="Wrap" />
                            <TextBlock Text="{x:Bind ViewModel.SelectedMap.MapFile, Mode=OneWay}" Opacity="0.7" FontFamily="Consolas" TextWrapping="Wrap" />
                            <TextBlock Text="{x:Bind ViewModel.SelectedMap.ArchiveFileName, Mode=OneWay}" Opacity="0.7" FontFamily="Consolas" TextWrapping="Wrap" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </PivotItem>

            <PivotItem Header="Games">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Button Content="Open games folder"
                            HorizontalAlignment="Left"
                            Command="{x:Bind ViewModel.OpenGamesFolderCommand}" />

                    <ListView Grid.Row="1"
                              ItemsSource="{x:Bind ViewModel.Games, Mode=OneWay}"
                              SelectedItem="{x:Bind ViewModel.SelectedGame, Mode=TwoWay}">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:GameArchive">
                                <StackPanel Padding="0,4">
                                    <TextBlock Text="{x:Bind Name}" />
                                    <TextBlock Text="{x:Bind ArchiveFileName}" Opacity="0.6" FontSize="12" FontFamily="Consolas" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </PivotItem>

            <PivotItem Header="Menus">
                <ListView ItemsSource="{x:Bind ViewModel.Menus, Mode=OneWay}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:MenuArchive">
                            <StackPanel Padding="0,4">
                                <TextBlock Text="{x:Bind Name}" />
                                <TextBlock Text="{x:Bind ArchiveFileName}" Opacity="0.6" FontSize="12" FontFamily="Consolas" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </PivotItem>

            <PivotItem Header="Engines">
                <ListView ItemsSource="{x:Bind ViewModel.Engines, Mode=OneWay}">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:EngineBuild">
                            <StackPanel Padding="0,4">
                                <TextBlock Text="{x:Bind DisplayName}" />
                                <TextBlock Text="{x:Bind Path}" Opacity="0.6" FontSize="12" FontFamily="Consolas" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </PivotItem>

        </Pivot>
    </Grid>
</local:ContentPageBase>
