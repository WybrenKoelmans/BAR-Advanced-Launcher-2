<?xml version="1.0" encoding="utf-8"?>
<local:HistoryPageBase
    x:Class="BAR_Advanced_Launcher_2.Views.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:BAR_Advanced_Launcher_2.Views"
    xmlns:models="using:BAR_Advanced_Launcher_2.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Loaded="OnLoaded">

    <Grid Padding="24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Spacing="4">
                <TextBlock Text="History" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock Text="Every launch this app has made, newest first. Replay one, or open the log it wrote."
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Opacity="0.7" />
            </StackPanel>

            <CommandBar Grid.Column="1"
                        DefaultLabelPosition="Right"
                        Background="Transparent"
                        IsOpen="False">
                <AppBarButton Icon="Refresh"
                              Label="Refresh"
                              Command="{x:Bind ViewModel.RefreshCommand}" />
                <AppBarButton Icon="Delete"
                              Label="Clear"
                              ToolTipService.ToolTip="Forget every recorded launch"
                              Command="{x:Bind ViewModel.ClearCommand}" />
            </CommandBar>
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ListView ItemsSource="{x:Bind ViewModel.Records}"
                          SelectedItem="{x:Bind ViewModel.SelectedRecord, Mode=TwoWay}"
                          SelectionMode="Single"
                          BorderThickness="1"
                          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                          CornerRadius="4">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:LaunchRecord">
                            <StackPanel Spacing="2" Padding="0,6">
                                <TextBlock Text="{x:Bind TitleText}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind StatusText}"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Opacity="0.6"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind StartedText}"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Opacity="0.45" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <TextBlock Grid.Row="1"
                           Text="{x:Bind ViewModel.Status, Mode=OneWay}"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Opacity="0.7"
                           TextWrapping="Wrap" />
            </Grid>

            <!-- Details for the selected run -->
            <Border Grid.Column="1"
                    Padding="16"
                    CornerRadius="8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    VerticalAlignment="Top"
                    Visibility="{x:Bind ViewModel.HasSelection, Mode=OneWay}">
                <StackPanel Spacing="10">
                    <TextBlock Text="{x:Bind ViewModel.SelectedRecord.TitleText, Mode=OneWay}"
                               Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.SelectedRecord.StatusText, Mode=OneWay}"
                               Opacity="0.8"
                               TextWrapping="Wrap" />

                    <InfoBar IsOpen="{x:Bind ViewModel.HasScriptDrift, Mode=OneWay}"
                             IsClosable="False"
                             Severity="Warning"
                             Message="{x:Bind ViewModel.ScriptDriftText, Mode=OneWay}" />

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Replay"
                                Style="{StaticResource AccentButtonStyle}"
                                Command="{x:Bind ViewModel.ReplayCommand}"
                                ToolTipService.ToolTip="Launch this run again, re-resolved against the current install" />
                        <Button Content="Open log"
                                Command="{x:Bind ViewModel.OpenLogCommand}"
                                ToolTipService.ToolTip="Show the infolog this run wrote" />
                        <Button Content="Copy command line"
                                Command="{x:Bind ViewModel.CopyCommandLineCommand}" />
                        <Button Content="More">
                            <Button.Flyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="Reveal start script"
                                                    Command="{x:Bind ViewModel.RevealScriptCommand}" />
                                    <MenuFlyoutItem Text="Remove from history"
                                                    Command="{x:Bind ViewModel.RemoveCommand}" />
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>

                    <TextBlock Text="Command line" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.SelectedCommandLine, Mode=OneWay}"
                               FontFamily="Consolas"
                               FontSize="12"
                               IsTextSelectionEnabled="True"
                               TextWrapping="Wrap"
                               Opacity="0.85" />

                    <TextBlock Text="{x:Bind ViewModel.SelectedRecord.ScriptPath, Mode=OneWay}"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Opacity="0.6"
                               IsTextSelectionEnabled="True"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</local:HistoryPageBase>
