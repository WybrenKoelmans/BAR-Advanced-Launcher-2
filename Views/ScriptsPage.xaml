<?xml version="1.0" encoding="utf-8"?>
<local:ScriptsPageBase
    x:Class="BAR_Advanced_Launcher_2.Views.ScriptsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:BAR_Advanced_Launcher_2.Views"
    xmlns:services="using:BAR_Advanced_Launcher_2.Services"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Loaded="OnLoaded">

    <Grid Padding="24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Text="{x:Bind ViewModel.Header, Mode=OneWay}"
                       Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock Text="Start scripts the engine can be pointed straight at."
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Opacity="0.7" />
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Library -->
            <Grid Grid.Column="0" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <CommandBar Grid.Row="0"
                            DefaultLabelPosition="Collapsed"
                            Background="Transparent"
                            HorizontalAlignment="Left"
                            IsOpen="False">
                    <AppBarButton Icon="Add" Label="New" ToolTipService.ToolTip="New script from a template">
                        <AppBarButton.Flyout>
                            <MenuFlyout x:Name="TemplateMenu" />
                        </AppBarButton.Flyout>
                    </AppBarButton>
                    <AppBarButton Icon="Copy"
                                  Label="Duplicate"
                                  ToolTipService.ToolTip="Duplicate"
                                  Command="{x:Bind ViewModel.DuplicateCommand}" />
                    <AppBarButton Icon="Rename"
                                  Label="Rename"
                                  ToolTipService.ToolTip="Rename"
                                  Command="{x:Bind ViewModel.RenameCommand}" />
                    <AppBarButton Icon="Delete"
                                  Label="Delete"
                                  ToolTipService.ToolTip="Delete to the recycle bin"
                                  Command="{x:Bind ViewModel.DeleteCommand}" />
                    <AppBarSeparator />
                    <AppBarButton Icon="Refresh"
                                  Label="Refresh"
                                  ToolTipService.ToolTip="Reread the library folder"
                                  Command="{x:Bind ViewModel.LoadCommand}" />
                    <AppBarButton Icon="Folder"
                                  Label="Open folder"
                                  ToolTipService.ToolTip="Open the library folder"
                                  Command="{x:Bind ViewModel.OpenLibraryFolderCommand}" />
                </CommandBar>

                <ListView Grid.Row="1"
                          ItemsSource="{x:Bind ViewModel.Scripts}"
                          SelectedItem="{x:Bind ViewModel.SelectedScript, Mode=TwoWay}"
                          SelectionMode="Single"
                          BorderThickness="1"
                          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                          CornerRadius="4">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="services:StartScriptFile">
                            <StackPanel Padding="0,6">
                                <TextBlock Text="{x:Bind DisplayName}" />
                                <TextBlock Text="{x:Bind LastWriteText}"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Opacity="0.6" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <TextBlock Grid.Row="2"
                           Text="{x:Bind ViewModel.Status, Mode=OneWay}"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           TextWrapping="Wrap"
                           Opacity="0.8" />
            </Grid>

            <!-- Editor -->
            <Grid Grid.Column="1" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <TextBlock Text="{x:Bind ViewModel.EditorHeader, Mode=OneWay}"
                               Style="{StaticResource SubtitleTextBlockStyle}"
                               VerticalAlignment="Center" />

                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <Button Content="Save"
                                Style="{StaticResource AccentButtonStyle}"
                                Command="{x:Bind ViewModel.SaveCommand}" />
                        <Button Content="Revert" Command="{x:Bind ViewModel.RevertCommand}" />
                        <Button Content="Tidy"
                                ToolTipService.ToolTip="Reformat the indentation from the parsed script"
                                Command="{x:Bind ViewModel.FormatCommand}" />
                        <CheckBox Content="Isolation"
                                  VerticalAlignment="Center"
                                  IsChecked="{x:Bind ViewModel.UseIsolation, Mode=TwoWay}"
                                  ToolTipService.ToolTip="Pass --isolation, limiting the games and maps scanner to this install. Applies to this page's Launch button; profiles carry their own setting." />
                        <Button Content="Launch" Command="{x:Bind ViewModel.LaunchCommand}" />
                        <Button Content="More">
                            <Button.Flyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="Open in external editor"
                                                    Command="{x:Bind ViewModel.OpenInEditorCommand}" />
                                    <MenuFlyoutItem Text="Show in Explorer"
                                                    Command="{x:Bind ViewModel.RevealCommand}" />
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="16">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="Map" VerticalAlignment="Center" Opacity="0.7" />
                        <ComboBox ItemsSource="{x:Bind ViewModel.MapNames}"
                                  SelectedItem="{x:Bind ViewModel.QuickMapName, Mode=TwoWay}"
                                  IsEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay}"
                                  PlaceholderText="(none)"
                                  MinWidth="220"
                                  ToolTipService.ToolTip="Quick-edit the [game] mapname field" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="Game" VerticalAlignment="Center" Opacity="0.7" />
                        <ComboBox ItemsSource="{x:Bind ViewModel.GameNames}"
                                  SelectedItem="{x:Bind ViewModel.QuickGameName, Mode=TwoWay}"
                                  IsEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay}"
                                  PlaceholderText="(none)"
                                  MinWidth="220"
                                  ToolTipService.ToolTip="Quick-edit the [game] gametype field" />
                    </StackPanel>
                </StackPanel>

                <InfoBar Grid.Row="2"
                         Severity="Error"
                         IsOpen="{x:Bind ViewModel.HasParseError, Mode=OneWay}"
                         IsClosable="False"
                         Title="This script does not parse"
                         Message="{x:Bind ViewModel.ParseError, Mode=OneWay}" />

                <TextBox Grid.Row="3"
                         Text="{x:Bind ViewModel.EditorText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         IsEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay}"
                         PlaceholderText="Select a script, or create one from a template."
                         AcceptsReturn="True"
                         TextWrapping="NoWrap"
                         IsSpellCheckEnabled="False"
                         FontFamily="Consolas"
                         FontSize="13"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         ScrollViewer.VerticalScrollMode="Enabled"
                         ScrollViewer.HorizontalScrollMode="Enabled" />

                <TextBlock Grid.Row="4"
                           Text="{x:Bind ViewModel.SelectedScriptPath, Mode=OneWay}"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           IsTextSelectionEnabled="True"
                           TextTrimming="CharacterEllipsis"
                           Opacity="0.6" />
            </Grid>
        </Grid>
    </Grid>
</local:ScriptsPageBase>
