<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="BAR_Advanced_Launcher_2.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:BAR_Advanced_Launcher_2.Converters"
    xmlns:local="using:BAR_Advanced_Launcher_2">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
            <converters:InfologSeverityBrushConverter x:Key="InfologSeverityBrushConverter" />
            <converters:DiffKindBrushConverter x:Key="DiffKindBrushConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
